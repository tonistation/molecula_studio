{
  "name": "molecula-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first storyboard studio. M1: persistence before generation.",
  "engines": {
    "node": ">=26.3.0 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p studio/tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "dev:companion": "node src/companion/main.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "start": "npm run build:studio && npm run dev:companion",
    "test:e2e": "npm run build:studio && node --test \"tests/e2e/**/*.e2e.ts\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-core": "^1.64.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
